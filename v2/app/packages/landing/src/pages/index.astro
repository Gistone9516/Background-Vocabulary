---
// 랜딩 한 페이지. **카피는 아직 들어오지 않았다** — 정본은 `v2/docs/왜-배경지식-설득논거.md`이고
// 그 문서가 스스로 "실제 카피 확정은 사용자 레드펜"이라고 적었다(L-5). 지금 이 파일은 뼈대이며,
// 아래 자리표시자에 확정된 문구가 들어온다.
//
// 이 파일에 프론트매터 스크립트를 두더라도 브라우저로 나가는 JS는 0이다 — Astro는 이 블록을
// 빌드 시점에만 실행한다. 브라우저 JS가 생기는 것은 <script> 태그나 클라이언트 아일랜드를
// 쓸 때뿐이고, 그 둘은 L-1이 금지한다(게이트가 산출물에서 검사한다).

// 디자인 토큰만 가져온다. 코드는 하나도 가져오지 않는다(L-2). 이 import가 통과하는 것은
// boundary-check의 자산 진입점 예외 덕이고, 같은 패키지의 코드를 가져오면 게이트가 막는다.
import "@vock/ui-shared/styles.css";

const APP_URL = "/app";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>배경노트</title>
    <!-- 설명 문구도 카피 확정 대상이다. 지금은 비워 둔다 — 근거 없는 문장을 메타에 박으면
         크롤러가 그것을 먼저 인용한다. -->
  </head>
  <body>
    <main class="scroll pad screenIn">
      <!-- TODO(L-5): 확정된 카피가 들어올 자리. 설득논거 9개 주장과 금지선 7항 안에서 조립하고
           사용자 레드펜을 받은 뒤 채운다. 그전까지 문장을 지어 넣지 않는다. -->
      <h1>배경노트</h1>

      <!-- 앱 진입 링크는 하나다(L-9). 랜딩에서 입력을 받기 시작하면 JS가 필요해져 L-1이 깨진다. -->
      <p><a href={APP_URL}>앱으로 가기</a></p>
    </main>
  </body>
</html>
